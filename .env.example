# 방송국 서버 설정 — M·K가 같은 코드를 씁니다.
# 이 파일을 복사해 .env.m(M 방송국), .env.k(K 방송국)를 만들고 값을 채웁니다. (.env.* 는 Git에 올리지 않음)
#   uvicorn app.main:app --port 8101 --env-file .env.m --timeout-graceful-shutdown 2
#   uvicorn app.main:app --port 8102 --env-file .env.k --timeout-graceful-shutdown 2
STATION_CODE=M
STATION_NAME=M 방송국
OTHER_STATION_URL=http://localhost:8102
# DB 파일 (비우면 station_m.db / station_k.db)
STATION_DB_URL=
SECRET_KEY=여기에-아무-긴-문자열
# 계정 5개(reporter1~3, desk1~2)의 처음 비밀번호
DEFAULT_PASSWORD=여기에-처음-비밀번호

# 선관위 서버 (nec-server의 seed.py가 보여 준 키)
NEC_BASE_URL=http://localhost:8000
NEC_API_KEY=여기에-선관위가-발급한-키
ELECTION_ID=HANBIT-2026
SYNC_INTERVAL_SEC=5

# OpenAI (팀 공용 키, 서버 PC에만) — 비우면 틀 기사 + 브라우저 음성으로 연습 가능
OPENAI_API_KEY=
LLM_MODEL=gpt-6-luna
LLM_FALLBACK=template
EMBED_MODEL=text-embedding-3-small
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=alloy

# 립싱크 아바타: none / mock (실제 서비스는 app/workers/avatar.py에 추가)
AVATAR_PROVIDER=none
AVATAR_TIMEOUT_SEC=90

# 클라우드 시연 모드 (Render)
DEMO_MODE=false
DEMO_AUTO_APPROVE=false

# 시간 측정 로그(⏱) — 느려지는 곳 찾기. 0이면 끔
TIMING_LOG=1
SLOW_REQUEST_MS=500
LOOP_LAG_MS=300
